# Apply the reviewed native-private bridge only to a build-owned copy. The
# FetchContent source (including host overrides/read-only caches) stays pristine.
function(horo_prepare_gns_selected_root pristine out_source)
    set(patch_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/patches/gns")
    file(READ "${patch_dir}/manifest.json" manifest)
    string(JSON expected_patch GET "${manifest}" patchSha256)
    file(SHA256 "${patch_dir}/horo-gns-selected-root-v1.patch" actual_patch)
    if(NOT actual_patch STREQUAL expected_patch)
        message(FATAL_ERROR "GNS selected-root patch differs from its reviewed manifest")
    endif()
    file(READ "${pristine}/LICENSE" license)
    string(REPLACE "\r\n" "\n" license "${license}")
    string(SHA256 license_hash "${license}")
    string(JSON expected_license GET "${manifest}" licenseSha256)
    if(NOT license_hash STREQUAL expected_license)
        message(FATAL_ERROR "GNS selected-root source license differs from the exact reviewed pin")
    endif()
    string(SUBSTRING "${actual_patch}" 0 16 patch_id)
    set(owned "${CMAKE_BINARY_DIR}/_deps/horo_gns-selected-${patch_id}")
    string(JSON path_count LENGTH "${manifest}" paths)
    math(EXPR last_path "${path_count} - 1")
    # Verify exact pristine contexts before copying, including CRLF Git checkouts.
    foreach(index RANGE 0 ${last_path})
        string(JSON path GET "${manifest}" paths ${index} path)
        string(JSON kind TYPE "${manifest}" paths ${index} pristineSha256)
        if(NOT kind STREQUAL "NULL")
            file(READ "${pristine}/${path}" text)
            string(REPLACE "\r\n" "\n" text "${text}")
            string(SHA256 digest "${text}")
            string(JSON expected GET "${manifest}" paths ${index} pristineSha256)
            if(NOT digest STREQUAL expected)
                message(FATAL_ERROR "GNS selected-root pristine context mismatch: ${path}")
            endif()
        endif()
    endforeach()
    if(NOT EXISTS "${owned}/.horo-selected-root-ready")
        if(EXISTS "${owned}")
            message(FATAL_ERROR "Incomplete GNS build-owned bridge copy requires explicit cleanup: ${owned}")
        endif()
        file(MAKE_DIRECTORY "${owned}")
        file(COPY "${pristine}/" DESTINATION "${owned}" PATTERN ".git" EXCLUDE)
        foreach(index RANGE 0 ${last_path})
            string(JSON path GET "${manifest}" paths ${index} path)
            if(EXISTS "${owned}/${path}")
                file(READ "${owned}/${path}" text)
                string(REPLACE "\r\n" "\n" text "${text}")
                # CONFIGURE emits one final LF for its template line. Remove only
                # the pinned source's final LF before the single variable expansion;
                # vendor @...@/${...} text is never interpreted as a template.
                string(REGEX REPLACE "\n$" "" text "${text}")
                file(CONFIGURE OUTPUT "${owned}/${path}" CONTENT "@text@" @ONLY NEWLINE_STYLE UNIX)
                file(SHA256 "${owned}/${path}" materialized)
                string(JSON expected GET "${manifest}" paths ${index} pristineSha256)
                if(NOT materialized STREQUAL expected)
                    message(FATAL_ERROR "GNS build-owned pristine bytes changed during normalization: ${path}")
                endif()
            endif()
        endforeach()
        find_package(Git REQUIRED)
        # An in-repository build directory must not let git discover the parent
        # Horo checkout and interpret patch paths relative to that worktree.
        # Keep reviewed candidate bytes independent of the caller's checkout conversion.
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE --unset=GIT_INDEX_FILE
                        "GIT_CEILING_DIRECTORIES=${owned}"
                        "${GIT_EXECUTABLE}" -c core.autocrlf=false apply "${patch_dir}/horo-gns-selected-root-v1.patch"
                        WORKING_DIRECTORY "${owned}" RESULT_VARIABLE applied ERROR_VARIABLE reason)
        if(NOT applied EQUAL 0)
            message(FATAL_ERROR "GNS build-owned selected-root patch failed: ${reason}")
        endif()
        file(WRITE "${owned}/.horo-selected-root-ready" "${actual_patch}\n")
    endif()
    foreach(index RANGE 0 ${last_path})
        string(JSON path GET "${manifest}" paths ${index} path)
        string(JSON expected GET "${manifest}" paths ${index} candidateSha256)
        file(SHA256 "${owned}/${path}" digest)
        if(NOT digest STREQUAL expected)
            message(FATAL_ERROR "GNS build-owned selected-root source changed: ${path}")
        endif()
    endforeach()
    set(${out_source} "${owned}" PARENT_SCOPE)
endfunction()
