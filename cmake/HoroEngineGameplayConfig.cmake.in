@PACKAGE_INIT@

set(HORO_GAMEPLAY_SDK_COMPILER_ID "@CMAKE_CXX_COMPILER_ID@")
set(HORO_GAMEPLAY_SDK_COMPILER_VERSION "@CMAKE_CXX_COMPILER_VERSION@")
set(HORO_GAMEPLAY_SDK_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@")
set(HORO_GAMEPLAY_SDK_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@")
set(HORO_GAMEPLAY_SDK_GENERATOR_PLATFORM "@CMAKE_GENERATOR_PLATFORM@")
set(HORO_GAMEPLAY_SDK_GENERATOR_TOOLSET "@CMAKE_GENERATOR_TOOLSET@")
set(HORO_GAMEPLAY_SDK_FINGERPRINT "@HORO_GAMEPLAY_SDK_FINGERPRINT@")
set(HORO_GAMEPLAY_SDK_CXX_STANDARD 20)
set(HORO_GAMEPLAY_SDK_FLAGS "@CMAKE_CXX_FLAGS@ @CMAKE_CXX_FLAGS_DEBUG@ @CMAKE_C_FLAGS@ @CMAKE_C_FLAGS_DEBUG@")
if(HORO_GAMEPLAY_SDK_FLAGS MATCHES "--coverage|-fprofile-arcs")
    set(HORO_GAMEPLAY_SDK_USES_COVERAGE TRUE)
else()
    set(HORO_GAMEPLAY_SDK_USES_COVERAGE FALSE)
endif()

if(NOT CMAKE_CXX_COMPILER_ID STREQUAL HORO_GAMEPLAY_SDK_COMPILER_ID OR
   NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL HORO_GAMEPLAY_SDK_COMPILER_VERSION OR
   NOT CMAKE_SYSTEM_NAME STREQUAL HORO_GAMEPLAY_SDK_SYSTEM_NAME OR
   NOT CMAKE_SYSTEM_PROCESSOR STREQUAL HORO_GAMEPLAY_SDK_SYSTEM_PROCESSOR)
    message(FATAL_ERROR
        "Horo gameplay SDK toolchain mismatch. SDK=${HORO_GAMEPLAY_SDK_COMPILER_ID} "
        "${HORO_GAMEPLAY_SDK_COMPILER_VERSION} ${HORO_GAMEPLAY_SDK_SYSTEM_NAME}/"
        "${HORO_GAMEPLAY_SDK_SYSTEM_PROCESSOR}; project=${CMAKE_CXX_COMPILER_ID} "
        "${CMAKE_CXX_COMPILER_VERSION} ${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}")
endif()

if(HORO_GAMEPLAY_SDK_GENERATOR_PLATFORM AND
   NOT CMAKE_GENERATOR_PLATFORM STREQUAL HORO_GAMEPLAY_SDK_GENERATOR_PLATFORM)
    message(FATAL_ERROR "Horo gameplay SDK generator platform mismatch")
endif()
if(HORO_GAMEPLAY_SDK_GENERATOR_TOOLSET AND
   NOT CMAKE_GENERATOR_TOOLSET STREQUAL HORO_GAMEPLAY_SDK_GENERATOR_TOOLSET)
    message(FATAL_ERROR "Horo gameplay SDK generator toolset mismatch")
endif()

find_package(Python3 REQUIRED COMPONENTS Interpreter)
include("${CMAKE_CURRENT_LIST_DIR}/HoroEngineGameplayTargets.cmake")
foreach(component IN LISTS HoroEngineGameplay_FIND_COMPONENTS)
    if(component STREQUAL "Physics")
        find_package(Threads REQUIRED)
        include("${CMAKE_CURRENT_LIST_DIR}/HoroEngineGameplayPhysicsTargets.cmake")
        set(HoroEngineGameplay_Physics_FOUND TRUE)
    else()
        set(HoroEngineGameplay_FOUND FALSE)
        set(HoroEngineGameplay_NOT_FOUND_MESSAGE "Unsupported gameplay SDK component: ${component}")
        return()
    endif()
endforeach()
set(HORO_GAMEPLAY_MODULE_CMAKE_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(HORO_GAMEPLAY_CODEGEN_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/generate_gameplay_behavior_bundle.py")
include("${CMAKE_CURRENT_LIST_DIR}/HoroGameplayModule.cmake")
