include_guard(GLOBAL)

set(HORO_DEPENDENCY_SDK_CACHE "" CACHE PATH "Directory of trusted dependency SDK archives")
option(HORO_BUILD_DEPENDENCY_SDK_PACKAGES "Expose dependency SDK packaging targets" OFF)

function(horo_sdk_json_field document key value)
    string(REPLACE "\\" "\\\\" escaped "${value}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    string(JSON updated SET "${${document}}" "${key}" "\"${escaped}\"")
    set(${document} "${updated}" PARENT_SCOPE)
endfunction()

# A single-config package is conservative about toolchain and SDK identity.
# Multi-config generators retain the ordinary source path until qualified.
function(horo_prepare_dependency_sdk name recipe output_root output_identity output_archive)
    set(${output_root} "" PARENT_SCOPE)
    set(${output_identity} "" PARENT_SCOPE)
    set(${output_archive} "" PARENT_SCOPE)
    if((NOT HORO_DEPENDENCY_SDK_CACHE AND NOT HORO_BUILD_DEPENDENCY_SDK_PACKAGES)
       OR CMAKE_CONFIGURATION_TYPES)
        return()
    endif()
    find_package(Python3 3.11 QUIET COMPONENTS Interpreter)
    if(NOT Python3_Interpreter_FOUND)
        message(STATUS "Dependency SDK ${name}: Python 3.11 unavailable; build from source")
        return()
    endif()

    file(SHA256 "${recipe}" recipe_hash)
    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" helper_hash)
    file(SHA256 "${CMAKE_CXX_COMPILER}" compiler_hash)
    string(TOUPPER "${CMAKE_BUILD_TYPE}" configuration)
    get_directory_property(directory_options COMPILE_OPTIONS)
    get_directory_property(directory_definitions COMPILE_DEFINITIONS)
    set(flags "${CMAKE_CXX_FLAGS}|${CMAKE_CXX_FLAGS_${configuration}}|${directory_options}|${directory_definitions}")
    # Coverage objects embed producer profile paths. Do not import them until
    # gcno/gcda relocation has independent qualification.
    if(HORO_CI_SONAR_COVERAGE OR flags MATCHES "coverage|profile|sanitize")
        message(STATUS "Dependency SDK ${name}: instrumentation requires source build")
        return()
    endif()
    set(sdk_metadata "")
    if(EXISTS "${CMAKE_OSX_SYSROOT}/SDKSettings.json")
        file(SHA256 "${CMAKE_OSX_SYSROOT}/SDKSettings.json" sdk_metadata)
    elseif(EXISTS "/etc/os-release")
        file(SHA256 "/etc/os-release" sdk_metadata)
    endif()
    set(identity "{}")
    horo_sdk_json_field(identity platform "${CMAKE_SYSTEM_NAME}|${CMAKE_SYSTEM_VERSION}")
    horo_sdk_json_field(identity architecture "${CMAKE_SYSTEM_PROCESSOR}|${CMAKE_OSX_ARCHITECTURES}|${CMAKE_CXX_COMPILER_TARGET}")
    horo_sdk_json_field(identity compiler "${CMAKE_CXX_COMPILER_ID}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_CXX_COMPILER_FRONTEND_VARIANT}|${compiler_hash}")
    horo_sdk_json_field(identity sdk "${CMAKE_SYSROOT}|${CMAKE_OSX_SYSROOT}|${CMAKE_OSX_DEPLOYMENT_TARGET}|${sdk_metadata}|$ENV{ImageOS}|$ENV{ImageVersion}")
    horo_sdk_json_field(identity abi "${CMAKE_SIZEOF_VOID_P}|${CMAKE_CXX_BYTE_ORDER}|${CMAKE_MSVC_RUNTIME_LIBRARY}|${CMAKE_CXX_STANDARD}|${CMAKE_CXX_EXTENSIONS}")
    horo_sdk_json_field(identity configuration "${CMAKE_BUILD_TYPE}|${flags}")
    horo_sdk_json_field(identity dependencies "${name}|${recipe_hash}")
    horo_sdk_json_field(identity recipe "${recipe_hash}|${helper_hash}|${CMAKE_VERSION}")
    horo_sdk_json_field(identity instrumentation "flags:${flags}")
    horo_sdk_json_field(identity features "${CMAKE_POSITION_INDEPENDENT_CODE}|${CMAKE_INTERPROCEDURAL_OPTIMIZATION}|${CMAKE_INTERPROCEDURAL_OPTIMIZATION_${configuration}}|${CMAKE_CXX_VISIBILITY_PRESET}|${CMAKE_VISIBILITY_INLINES_HIDDEN}|$ENV{CPATH}|$ENV{CPLUS_INCLUDE_PATH}|$ENV{INCLUDE}")
    string(SHA256 identity_hash "${identity}")
    set(identity_file "${CMAKE_BINARY_DIR}/dependency-sdk/${name}-${identity_hash}.json")
    file(WRITE "${identity_file}" "${identity}\n")
    set(archive_name "${name}-${identity_hash}.tar.gz")
    set(${output_identity} "${identity_file}" PARENT_SCOPE)
    set(${output_archive} "${archive_name}" PARENT_SCOPE)
    set(HORO_DEPENDENCY_SDK_PYTHON "${Python3_EXECUTABLE}" PARENT_SCOPE)
    if(NOT HORO_DEPENDENCY_SDK_CACHE)
        return()
    endif()
    set(restored "${CMAKE_BINARY_DIR}/dependency-sdk/restored/${name}-${identity_hash}")
    set(tool "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.github/scripts/dependency_package.py")
    if(EXISTS "${restored}")
        set(operation verify --root "${restored}")
    elseif(EXISTS "${HORO_DEPENDENCY_SDK_CACHE}/${archive_name}")
        set(operation restore --archive "${HORO_DEPENDENCY_SDK_CACHE}/${archive_name}" --destination "${restored}")
    else()
        message(STATUS "Dependency SDK ${name}: no compatible package; build from source")
        return()
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${tool}" ${operation} --identity "${identity_file}"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 120)
    if(NOT result STREQUAL "0")
        message(STATUS "Dependency SDK ${name}: verification failed; build from source (${result})")
        return()
    endif()
    message(STATUS "Dependency SDK ${name}: verified ${archive_name}")
    set(${output_root} "${restored}" PARENT_SCOPE)
endfunction()
