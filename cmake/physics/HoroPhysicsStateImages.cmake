# Process image evidence stays Platform-owned and outside the installed Physics SDK.
set(_horo_image_headers "${CMAKE_CURRENT_BINARY_DIR}/internal/process-image")
file(MAKE_DIRECTORY "${_horo_image_headers}")
file(WRITE "${_horo_image_headers}/ProcessImageIdentity.h"
    "#pragma once\n#include \"${PROJECT_SOURCE_DIR}/src/platform/process_image/ProcessImageIdentity.h\"\n")
add_library(HoroPlatformProcessImageInternal STATIC)
target_compile_features(HoroPlatformProcessImageInternal PUBLIC cxx_std_20)
target_include_directories(HoroPlatformProcessImageInternal PUBLIC "$<BUILD_INTERFACE:${_horo_image_headers}>")
target_link_libraries(HoroPlatformProcessImageInternal PUBLIC HoroEngine::Foundation)
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    target_sources(HoroPlatformProcessImageInternal PRIVATE platform/process_image/ProcessImageIdentity_Mac.cpp)
    target_link_libraries(HoroPlatformProcessImageInternal PRIVATE "-framework Security" "-framework CoreFoundation")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    target_sources(HoroPlatformProcessImageInternal PRIVATE platform/process_image/ProcessImageIdentity_Linux.cpp)
    target_link_libraries(HoroPlatformProcessImageInternal PRIVATE ${CMAKE_DL_LIBS})
elseif(WIN32)
    target_sources(HoroPlatformProcessImageInternal PRIVATE platform/process_image/ProcessImageIdentity_Windows.cpp)
else()
    target_sources(HoroPlatformProcessImageInternal PRIVATE platform/process_image/ProcessImageIdentity_Unavailable.cpp)
endif()

set(_horo_state_identity_headers "${CMAKE_CURRENT_BINARY_DIR}/internal/physics-state-identity")
file(MAKE_DIRECTORY "${_horo_state_identity_headers}")
configure_file(physics/PhysicsStateImagesInternal.h
    "${_horo_state_identity_headers}/PhysicsStateImagesInternal.h" COPYONLY)
add_library(HoroPhysicsStateIdentityInternal INTERFACE)
target_include_directories(HoroPhysicsStateIdentityInternal INTERFACE "$<BUILD_INTERFACE:${_horo_state_identity_headers}>")
target_link_libraries(HoroPhysicsStateIdentityInternal INTERFACE HoroEngine::Physics)
if(HORO_BUILD_PHYSICS_NATIVE)
    target_include_directories(HoroPhysicsStateIdentityInternal INTERFACE "${CMAKE_CURRENT_BINARY_DIR}/physics-state/$<CONFIG>")
    add_dependencies(HoroPhysicsStateIdentityInternal HoroPhysicsStateBuildFacts)
endif()
