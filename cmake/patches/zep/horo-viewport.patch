+// Modified by Horo Engine: expose bounded viewport state only to its private adapter.
+float ZepWindow::GetHoroViewportLines()
+{
+    UpdateLayout();
+    ScrollToCursor();
+    return m_textOffsetPx / float(std::max(1, m_defaultLineSize));
+}
+
+void ZepWindow::SetHoroViewportLines(float lines)
+{
+    if (!std::isfinite(lines))
+        return;
+    UpdateLayout();
+    const double pixels = double(lines) * double(std::max(1, m_defaultLineSize));
+    const double maximum = std::max(0.0, double(m_textSizePx.y) - double(m_textRegion->rect.Height()));
+    m_textOffsetPx = float(std::clamp(pixels, 0.0, maximum));
+    // A restored viewport is authoritative for this view, including when its caret is outside the visible region.
+    m_cursorMoved = false;
+    UpdateVisibleLineRange();
+    UpdateScrollers();
+}
