+bool CertStore_HoroInstallRoot(const std::uint8_t *key32, std::uint32_t appId, std::uint64_t *generation)
+{
+    SteamNetworkingGlobalLock::AssertHeldByCurrentThread();
+    if (!key32 || !generation || !appId || s_horoRoot.rootGeneration ||
