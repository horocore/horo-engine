+    selected->m_eTrust = k_ETrust_Hardcoded;
+    selected->m_effectiveAuthScope.SetAll();
+    const AppId_t selectedApp = appId;
+    selected->m_effectiveAuthScope.m_apps.Setup(&selectedApp, 1);
+    const uint64 id = selected->CalculateKeyID();
+    decltype(s_mapPublicKeys) replacement;
+    replacement.Insert(id, std::move(selected));
+    HoroNativeChannel root = {};
+    root.appId = appId;
+    SHA256Digest_t digest;
+    CCrypto::GenerateSHA256Digest(key32, 32, &digest);
+    V_memcpy(root.rootDigest, &digest, sizeof(digest));
+    root.rootGeneration = s_horoLastRootGeneration + 1;
+    // Native Swap exchanges storage without allocation; publication cannot fail.
+    s_mapPublicKeys.Swap(replacement);
+    s_bTrustValid = false;
+    s_horoRoot = root;
+    s_horoRootReady = true;
+    s_horoLastRootGeneration = root.rootGeneration;
+    *generation = root.rootGeneration;
+    return true;
+}
