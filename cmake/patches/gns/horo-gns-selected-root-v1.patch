+// Horo private extension to pinned GameNetworkingSockets v1.6.0.
+// Upstream BSD-3-Clause license is retained. Not an installed GNS/Horo API.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+namespace SteamNetworkingSocketsLib {
+enum class HoroBridgeStatus : std::uint8_t { Ok, Unavailable, Stale, Untrusted, Expired, Invalid };
+// Public evidence copied from a live native owner. No key material is exported.
+// Identity kinds: 1=SteamID little-endian eight bytes, 2=generic bytes (1..32).
+struct HoroNativeChannel {
+    std::uint64_t rootGeneration;
+    std::uint64_t incarnation;
+    std::uint64_t certificateExpiry;
+    std::uint32_t appId;
+    std::uint8_t rootDigest[32];
+    std::uint8_t certificateDigest[32];
+    std::uint8_t identity[32];
+    std::uint8_t identityBytes;
+    std::uint8_t identityKind;
+};
+// Root selection is exclusive, before any listeners/connections. Failed installs
+// leave prior state intact. No live rotation. Generation counters never wrap.
+HoroBridgeStatus HoroInstallSelectedRoot(const std::uint8_t *key32, std::uint32_t appId,
+                                        std::uint64_t *generation) noexcept;
+HoroBridgeStatus HoroInspectNativeChannel(std::uint32_t nativeHandle, HoroNativeChannel *out) noexcept;
+// Expected evidence is revalidated under the SAME native connection lock.
+// Context is synchronous, public, 1..512 bytes. Result is NON-AUTHENTICATING
+// correlation only: not a signature, MAC, exporter, credential or possession proof.
+HoroBridgeStatus HoroAttestNativeKeyOwner(std::uint32_t nativeHandle, const HoroNativeChannel *expected,
+                                         const std::uint8_t *context, std::size_t bytes,
+                                         std::uint8_t *correlationDigest32) noexcept;
+// After all native listeners/connections drain (normally after native Kill).
+HoroBridgeStatus HoroRetireSelectedRoot(std::uint64_t generation) noexcept;
+// Cert-store helpers require SteamNetworkingGlobalLock; no provider callbacks.
+bool CertStore_HoroInstallRoot(const std::uint8_t *key32, std::uint32_t appId, std::uint64_t *generation);
+bool CertStore_HoroRoot(HoroNativeChannel &out);
+bool CertStore_HoroSelectedMode();
+bool CertStore_HoroRetireRoot(std::uint64_t generation);
+struct HoroNativeBridge;
+}
