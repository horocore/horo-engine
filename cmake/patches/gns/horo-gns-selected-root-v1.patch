+bool CertStore_HoroRetireRoot(std::uint64_t generation)
+{
+    SteamNetworkingGlobalLock::AssertHeldByCurrentThread();
+    if (!generation || generation != s_horoRoot.rootGeneration)
+        return false;
+    CertStore_Reset();
+    s_horoRoot = HoroNativeChannel{};
+    return true;
+}
