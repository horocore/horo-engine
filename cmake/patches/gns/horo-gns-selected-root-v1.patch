+
+bool HoroNativeBridge::Capture(CSteamNetworkConnectionBase &connection)
+{
+    connection.AssertLocksHeldByCurrentThread();
+    connection.m_horoVerifiedChannel = HoroNativeChannel{};
+    HoroNativeChannel selected = {};
+    if (!CertStore_HoroRoot(selected))
+        return !CertStore_HoroSelectedMode(); // Reset selected mode never becomes raw.
+    if (!connection.m_horoIncarnation || !connection.m_bRemoteCertHasTrustedCASignature ||
+        connection.m_eNegotiatedCipher != k_ESteamNetworkingSocketsCipher_AES_256_GCM ||
+        !connection.m_pCryptContextSend || !connection.m_pCryptContextRecv || connection.m_sCertRemote.empty())
+        return false;
+    SteamNetworkingIdentity certifiedIdentity;
+    SteamNetworkingErrMsg error;
+    if (SteamNetworkingIdentityFromCert(certifiedIdentity, connection.m_msgCertRemote, error) <= 0 ||
+        !(certifiedIdentity == connection.m_identityRemote))
+        return false;
+    const std::uint64_t steamId = certifiedIdentity.GetSteamID64();
+    if (steamId)
+    {
+        selected.identityKind = 1;
+        selected.identityBytes = 8;
+        for (unsigned i = 0; i < 8; ++i)
+            selected.identity[i] = static_cast<std::uint8_t>(steamId >> (i * 8));
+    }
+    else
+    {
+        int count = 0;
+        const uint8 *bytes = certifiedIdentity.GetGenericBytes(count);
+        if (!bytes || count <= 0 || count > 32)
+            return false;
+        selected.identityKind = 2;
+        selected.identityBytes = static_cast<std::uint8_t>(count);
+        V_memcpy(selected.identity, bytes, count);
+    }
+    SHA256Digest_t digest;
+    CCrypto::GenerateSHA256Digest(connection.m_sCertRemote.data(), connection.m_sCertRemote.size(), &digest);
+    V_memcpy(selected.certificateDigest, &digest, sizeof(digest));
+    selected.incarnation = connection.m_horoIncarnation;
+    selected.certificateExpiry = connection.m_msgCertRemote.time_expiry();
+    connection.m_horoVerifiedChannel = selected;
+    return true;
+}
+
+HoroBridgeStatus HoroNativeBridge::Read(CSteamNetworkConnectionBase &connection, HoroNativeChannel &out)
+{
+    connection.AssertLocksHeldByCurrentThread();
+    HoroNativeChannel selected = {};
+    if (!CertStore_HoroRoot(selected))
+        return HoroBridgeStatus::Unavailable;
+    const HoroNativeChannel &verified = connection.m_horoVerifiedChannel;
+    if (connection.m_pSteamNetworkingSocketsInterface->m_pSteamNetworkingUtils->GetAppID() != verified.appId)
+        return HoroBridgeStatus::Stale;
+    if (!verified.rootGeneration || selected.rootGeneration != verified.rootGeneration ||
+        V_memcmp(selected.rootDigest, verified.rootDigest, 32) != 0)
+        return HoroBridgeStatus::Untrusted;
+    if (connection.GetState() != k_ESteamNetworkingConnectionState_Connected ||
+        !connection.m_bCryptKeysValid || !connection.m_bRemoteCertHasTrustedCASignature ||
+        connection.m_eNegotiatedCipher != k_ESteamNetworkingSocketsCipher_AES_256_GCM ||
+        !connection.m_pCryptContextSend || !connection.m_pCryptContextRecv)
+        return HoroBridgeStatus::Unavailable;
+    const time_t now = connection.m_pSteamNetworkingSocketsInterface->m_pSteamNetworkingUtils->GetTimeSecure();
+    if (now < 0 || verified.certificateExpiry <= static_cast<std::uint64_t>(now))
+        return HoroBridgeStatus::Expired;
+    out = verified;
+    return HoroBridgeStatus::Ok;
+}
+
+HoroBridgeStatus HoroInstallSelectedRoot(const std::uint8_t *key32, std::uint32_t appId,
+                                        std::uint64_t *generation) noexcept
+{
+    if (generation) *generation = 0;
+    if (!key32 || !appId || !generation)
+        return HoroBridgeStatus::Invalid;
+    try
+    {
+        SteamNetworkingGlobalLock global("HoroInstallSelectedRoot");
+        { TableScopeLock tables(g_tables_lock);
+          if (g_mapConnections.Count() || g_mapListenSockets.Count()) return HoroBridgeStatus::Unavailable; }
+        auto *utils = static_cast<CSteamNetworkingUtils *>(SteamNetworkingUtils());
+        if (!utils) return HoroBridgeStatus::Unavailable;
+        const AppId_t oldApp = utils->GetAppID();
+        if (oldApp && oldApp != appId) return HoroBridgeStatus::Invalid;
+        if (!CertStore_HoroInstallRoot(key32, appId, generation)) return HoroBridgeStatus::Invalid;
+        utils->SetAppID(appId); // Explicit host value; never infer the selected app.
+        return HoroBridgeStatus::Ok;
+    }
+    catch (...) { return HoroBridgeStatus::Unavailable; }
+}
+
+HoroBridgeStatus HoroInspectNativeChannel(std::uint32_t nativeHandle, HoroNativeChannel *out) noexcept
+{
+    if (!out) return HoroBridgeStatus::Invalid;
+    *out = HoroNativeChannel{};
+    try
+    {
+        SteamNetworkingGlobalLock global("HoroInspectNativeChannel");
+        ConnectionScopeLock lock;
+        auto *connection = GetConnectionByHandle(nativeHandle, lock);
+        return connection ? HoroNativeBridge::Read(*connection, *out) : HoroBridgeStatus::Stale;
+    }
+    catch (...) { return HoroBridgeStatus::Unavailable; }
+}
+
+HoroBridgeStatus HoroAttestNativeKeyOwner(std::uint32_t nativeHandle, const HoroNativeChannel *expected,
+                                         const std::uint8_t *context, std::size_t bytes,
+                                         std::uint8_t *correlationDigest32) noexcept
+{
+    if (correlationDigest32) V_memset(correlationDigest32, 0, 32);
+    if (!expected || !context || !bytes || bytes > 512 || !correlationDigest32)
+        return HoroBridgeStatus::Invalid;
+    try
+    {
+        SteamNetworkingGlobalLock global("HoroAttestNativeKeyOwner");
+        ConnectionScopeLock lock;
+        auto *connection = GetConnectionByHandle(nativeHandle, lock);
+        if (!connection) return HoroBridgeStatus::Stale;
+        HoroNativeChannel actual = {};
+        const HoroBridgeStatus status = HoroNativeBridge::Read(*connection, actual);
+        if (status != HoroBridgeStatus::Ok) return status;
+        if (actual.rootGeneration != expected->rootGeneration || actual.incarnation != expected->incarnation ||
+            actual.appId != expected->appId || actual.certificateExpiry != expected->certificateExpiry ||
+            actual.identityKind != expected->identityKind || actual.identityBytes != expected->identityBytes ||
+            V_memcmp(actual.rootDigest, expected->rootDigest, 32) ||
+            V_memcmp(actual.certificateDigest, expected->certificateDigest, 32) ||
+            V_memcmp(actual.identity, expected->identity, 32)) return HoroBridgeStatus::Stale;
+        // Fixed canonical public encoding; do not hash struct padding or native keys.
+        std::uint8_t buffer[704] = {}; std::size_t count = 0;
+        const char domain[] = "HoroNativeChannelCorrelation/v1";
+        V_memcpy(buffer, domain, sizeof(domain)-1); count += sizeof(domain)-1;
+        const std::uint64_t fields[] = {actual.rootGeneration, actual.incarnation, actual.certificateExpiry, actual.appId, bytes};
+        for (const auto field : fields) for (unsigned i = 0; i < 8; ++i) buffer[count++] = static_cast<std::uint8_t>(field >> (i*8));
+        V_memcpy(buffer+count, actual.rootDigest, 32); count += 32;
+        V_memcpy(buffer+count, actual.certificateDigest, 32); count += 32;
+        buffer[count++] = actual.identityKind; buffer[count++] = actual.identityBytes;
+        V_memcpy(buffer+count, actual.identity, 32); count += 32;
+        V_memcpy(buffer+count, context, bytes); count += bytes;
+        SHA256Digest_t digest; CCrypto::GenerateSHA256Digest(buffer, count, &digest);
+        V_memcpy(correlationDigest32, &digest, sizeof(digest));
+        return HoroBridgeStatus::Ok;
+    }
+    catch (...) { return HoroBridgeStatus::Unavailable; }
+}
+
+HoroBridgeStatus HoroRetireSelectedRoot(std::uint64_t generation) noexcept
+{
+    try
+    {
+        SteamNetworkingGlobalLock global("HoroRetireSelectedRoot");
+        { TableScopeLock tables(g_tables_lock);
+          if (g_mapConnections.Count() || g_mapListenSockets.Count()) return HoroBridgeStatus::Unavailable; }
+        return CertStore_HoroRetireRoot(generation) ? HoroBridgeStatus::Ok : HoroBridgeStatus::Stale;
+    }
+    catch (...) { return HoroBridgeStatus::Unavailable; }
+}
