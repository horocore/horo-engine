include_guard(GLOBAL)

# This is a product boundary, independent of CMAKE_BUILD_TYPE. Release-mode tests may
# deliberately link the harness; neither shipping host may acquire its implementation.
function(horo_verify_network_chaos_boundary host)
    if(NOT TARGET "${host}")
        return()
    endif()
    set(pending "${host}")
    set(visited)
    while(pending)
        list(POP_FRONT pending current)
        if(NOT TARGET "${current}" OR current IN_LIST visited)
            continue()
        endif()
        list(APPEND visited "${current}")
        if(current MATCHES "(NetworkTransportNull|NetworkChaosHarness)")
            message(FATAL_ERROR "Network chaos product boundary: ${host} reaches test-only ${current}; use PRODUCTION_GNS or DISABLED for shipping hosts")
        endif()
        get_target_property(alias "${current}" ALIASED_TARGET)
        if(alias)
            list(APPEND pending "${alias}")
        endif()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(links "${current}" "${property}")
            foreach(link IN LISTS links)
                # Resolve link wrappers as well as conditional branches: neither branch may
                # introduce fault injection into an installed product configuration.
                string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_:.-]*" candidates "${link}")
                foreach(candidate IN LISTS candidates)
                    if(TARGET "${candidate}")
                        list(APPEND pending "${candidate}")
                    endif()
                endforeach()
            endforeach()
        endforeach()
    endwhile()
endfunction()

# Run on the actual configured source graph, before tests are added. Absent target
# owners cannot publish headers or participate in an installed target export.
function(horo_verify_network_chaos_release_inventory)
    if(BUILD_TESTING)
        return()
    endif()
    foreach(injection IN ITEMS HoroNetworkTransportNull HoroEngine::NetworkTransportNull
            HoroNetworkChaosHarness HoroEngine::NetworkChaosHarness)
        if(TARGET "${injection}")
            message(FATAL_ERROR "Non-testing network inventory contains ${injection}; fault injection must be built only with BUILD_TESTING")
        endif()
    endforeach()
    get_property(boundaries GLOBAL PROPERTY HORO_HEADER_BOUNDARY_TARGETS)
    foreach(boundary IN LISTS boundaries)
        get_target_property(headers "${boundary}" HORO_PUBLIC_HEADERS)
        if(headers MATCHES "Horo/Network/(DeterministicTransport|NetworkChaosScenario)\\.h")
            message(FATAL_ERROR "Non-testing network header surface publishes fault injection from ${boundary}")
        endif()
    endforeach()
endfunction()
