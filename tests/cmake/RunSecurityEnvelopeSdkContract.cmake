foreach(required SDK_DIR TEST_ROOT CONSUMER_SOURCE CXX_COMPILER)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing envelope SDK contract input: ${required}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${TEST_ROOT}/source")
configure_file("${CONSUMER_SOURCE}" "${TEST_ROOT}/source/Consumer.cpp" COPYONLY)
file(WRITE "${TEST_ROOT}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.25)
project(SecurityEnvelopeSdkConsumer LANGUAGES CXX)
find_package(HoroEngineGameplay CONFIG REQUIRED)
if(NOT TARGET HoroEngine::SecurityEnvelope OR TARGET HoroEngine::Security)
    message(FATAL_ERROR "Minimal SDK must import the envelope without the full verifier/provider")
endif()
get_target_property(kind HoroEngine::SecurityEnvelope TYPE)
get_target_property(dependencies HoroEngine::SecurityEnvelope INTERFACE_LINK_LIBRARIES)
if(NOT kind STREQUAL "INTERFACE_LIBRARY" OR NOT dependencies STREQUAL "HoroEngine::Foundation")
    message(FATAL_ERROR "Envelope SDK target lost its Foundation-only data boundary")
endif()
add_library(SecurityEnvelopeSdkConsumer OBJECT Consumer.cpp)
target_compile_features(SecurityEnvelopeSdkConsumer PRIVATE cxx_std_20)
target_link_libraries(SecurityEnvelopeSdkConsumer PRIVATE HoroEngine::SecurityEnvelope)
]=])
set(arguments)
if(GENERATOR)
    list(APPEND arguments -G "${GENERATOR}")
endif()
if(GENERATOR_PLATFORM)
    list(APPEND arguments -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND arguments -T "${GENERATOR_TOOLSET}")
endif()
foreach(setting CMAKE_CXX_COMPILER_LAUNCHER CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_DEBUG
        CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET)
    if(DEFINED ${setting} AND NOT "${${setting}}" STREQUAL "")
        list(APPEND arguments "-D${setting}=${${setting}}")
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/source" -B "${TEST_ROOT}/build" ${arguments}
    "-DHoroEngineGameplay_DIR=${SDK_DIR}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_BUILD_TYPE=${BUILD_CONFIG}"
    RESULT_VARIABLE configured OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT configured EQUAL 0)
    message(FATAL_ERROR "Envelope SDK configure failed: ${output}\n${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_ROOT}/build" --config "${BUILD_CONFIG}"
    --target SecurityEnvelopeSdkConsumer --parallel 1 RESULT_VARIABLE built OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT built EQUAL 0)
    message(FATAL_ERROR "Actual envelope SDK header consumer failed: ${output}\n${error}")
endif()
