foreach(required SDK_DIR FIXTURE_DIR TEST_ROOT CXX_COMPILER GENERATOR)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing runtime console SDK input: ${required}")
    endif()
endforeach()
set(config_args)
if(DEFINED BUILD_CONFIG AND NOT "${BUILD_CONFIG}" STREQUAL "")
    list(APPEND config_args --config "${BUILD_CONFIG}")
endif()
set(generator_args -G "${GENERATOR}")
if(GENERATOR_PLATFORM)
    list(APPEND generator_args -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND generator_args -T "${GENERATOR_TOOLSET}")
endif()
set(toolchain_args)
foreach(setting CMAKE_MAKE_PROGRAM CMAKE_LINKER CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET)
    if(DEFINED ${setting} AND NOT "${${setting}}" STREQUAL "")
        list(APPEND toolchain_args "-D${setting}=${${setting}}")
    endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${FIXTURE_DIR}" -B "${TEST_ROOT}"
    ${generator_args} ${toolchain_args} "-DHoroEngineGameplay_DIR=${SDK_DIR}"
    "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_BUILD_TYPE=${BUILD_CONFIG}" RESULT_VARIABLE configured)
if(NOT "${configured}" STREQUAL "0")
    message(FATAL_ERROR "Runtime console external SDK configure failed: ${configured}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_ROOT}" ${config_args}
    --target HoroRuntimeConsoleSdkConsumer --parallel 1 RESULT_VARIABLE built)
if(NOT "${built}" STREQUAL "0")
    message(FATAL_ERROR "Runtime console external SDK build failed: ${built}")
endif()
file(READ "${TEST_ROOT}/consumer-${BUILD_CONFIG}.txt" consumer)
execute_process(COMMAND "${consumer}" RESULT_VARIABLE ran TIMEOUT 45)
if(NOT "${ran}" STREQUAL "0")
    message(FATAL_ERROR "Runtime console external SDK execution contract failed: ${ran}")
endif()
