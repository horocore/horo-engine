cmake_minimum_required(VERSION 3.25)

foreach(required IN ITEMS SDK_DIR EXAMPLE_DIR TEST_ROOT CTEST_COMMAND GENERATOR CMAKE_C_COMPILER CMAKE_CXX_COMPILER)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing Gameplay AI SDK qualification input: ${required}")
    endif()
endforeach()
if(NOT BUILD_CONFIG)
    set(BUILD_CONFIG Debug)
endif()

function(require_success phase result)
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Gameplay AI example ${phase} failed (${result}). Reproduction directory: ${run_root}")
    endif()
endfunction()

set(generator_args -G "${GENERATOR}")
if(GENERATOR_PLATFORM)
    list(APPEND generator_args -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND generator_args -T "${GENERATOR_TOOLSET}")
endif()
set(toolchain_args)
foreach(setting IN ITEMS CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_MAKE_PROGRAM CMAKE_LINKER CMAKE_OSX_SYSROOT
        CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET)
    if(DEFINED ${setting} AND NOT "${${setting}}" STREQUAL "")
        string(REPLACE ";" "\\;" value "${${setting}}")
        list(APPEND toolchain_args "-D${setting}=${value}")
    endif()
endforeach()

file(MAKE_DIRECTORY "${TEST_ROOT}")
file(REAL_PATH "${TEST_ROOT}" owned_root)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(run_root "${owned_root}/guard-${nonce}")
if(EXISTS "${run_root}")
    message(FATAL_ERROR "Gameplay AI qualification directory already exists: ${run_root}")
endif()
file(MAKE_DIRECTORY "${run_root}/source")
file(COPY "${EXAMPLE_DIR}/" DESTINATION "${run_root}/source")
set(build "${run_root}/build")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${run_root}/source" -B "${build}"
    ${generator_args} ${toolchain_args}
    "-DHoroEngineGameplay_DIR=${SDK_DIR}" "-DCMAKE_BUILD_TYPE=${BUILD_CONFIG}" -DBUILD_TESTING=ON
    RESULT_VARIABLE result)
require_success(configure "${result}")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config "${BUILD_CONFIG}" --parallel 2 RESULT_VARIABLE result)
require_success(build "${result}")

execute_process(COMMAND "${CTEST_COMMAND}" --test-dir "${build}" -C "${BUILD_CONFIG}" --show-only=json-v1
    RESULT_VARIABLE result OUTPUT_VARIABLE discovery)
require_success(discovery "${result}")
string(JSON count LENGTH "${discovery}" tests)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Expected both Gameplay AI example cases, found ${count}: ${run_root}")
endif()
string(JSON first GET "${discovery}" tests 0 name)
string(JSON second GET "${discovery}" tests 1 name)
set(names "${first}" "${second}")
list(SORT names)
if(NOT names STREQUAL "HoroGuardSensesNearbyTargets;HoroGuardWaypointFixedTicks")
    message(FATAL_ERROR "Unexpected Gameplay AI example cases: ${names}")
endif()
execute_process(COMMAND "${CTEST_COMMAND}" --test-dir "${build}" -C "${BUILD_CONFIG}" --no-tests=error --output-on-failure
    RESULT_VARIABLE result)
require_success(test "${result}")

file(REAL_PATH "${run_root}" resolved_run)
cmake_path(IS_PREFIX owned_root "${resolved_run}" NORMALIZE is_owned)
if(is_owned AND resolved_run STREQUAL run_root AND NOT resolved_run STREQUAL owned_root)
    file(REMOVE_RECURSE "${resolved_run}")
endif()
