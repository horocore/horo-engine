foreach(required IN ITEMS HORO_REFERENCE_EXAMPLE_SOURCE HORO_EXTENSION_SDK_PACKAGE_DIR
        HORO_EXTENSION_VALIDATOR HORO_EXTENSION_CONFORMANCE HORO_REFERENCE_ACTIVATION_TEST
        HORO_REFERENCE_CLI_TEST HORO_REFERENCE_CLI HORO_TEST_BINARY_DIR)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Missing reference-example qualification input: ${required}")
    endif()
endforeach()

function(reference_run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Reference example command failed (${status}): ${ARGV}")
    endif()
endfunction()

# This directory is the test's explicit owned output, never an example's source or installed package root.
file(REMOVE_RECURSE "${HORO_TEST_BINARY_DIR}")
file(MAKE_DIRECTORY "${HORO_TEST_BINARY_DIR}")
foreach(shape IN ITEMS gui-basic backend-library-basic script-api-basic hybrid-basic)
    set(copy "${HORO_TEST_BINARY_DIR}/${shape}-source")
    set(build "${HORO_TEST_BINARY_DIR}/${shape}-build")
    set(package "${HORO_TEST_BINARY_DIR}/${shape}-package")
    set(identity "com.horo.reference.${shape}")
    file(COPY "${HORO_REFERENCE_EXAMPLE_SOURCE}/${shape}/" DESTINATION "${copy}")
    set(configure "${CMAKE_COMMAND}" -S "${copy}" -B "${build}" -G "${CMAKE_GENERATOR}"
        "-DHoroEngineExtensionSdk_DIR=${HORO_EXTENSION_SDK_PACKAGE_DIR}/lib/cmake/HoroEngineExtensionSdk"
        "-DEXAMPLE_ID=${identity}" -DBUILD_TESTING=ON)
    if(CMAKE_GENERATOR_PLATFORM)
        list(APPEND configure -A "${CMAKE_GENERATOR_PLATFORM}")
    endif()
    if(CMAKE_GENERATOR_TOOLSET)
        list(APPEND configure -T "${CMAKE_GENERATOR_TOOLSET}")
    endif()
    reference_run(${configure})
    reference_run("${CMAKE_COMMAND}" --build "${build}" --config Release)
    reference_run("${CMAKE_CTEST_COMMAND}" --test-dir "${build}" -C Release --no-tests=error --output-on-failure --timeout 30)
    reference_run("${CMAKE_COMMAND}" --build "${build}" --target package --config Release)
    set(archive "${build}/${identity}-1.0.0.zip")
    if(NOT EXISTS "${archive}")
        message(FATAL_ERROR "Actual reference package artifact is missing: ${archive}")
    endif()
    file(MAKE_DIRECTORY "${package}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${package}")
    reference_run("${HORO_EXTENSION_VALIDATOR}" --json "${package}/extension.json")
    file(GLOB modules "${package}/bin/reference_*")
    if(NOT modules)
        message(FATAL_ERROR "Reference package has no actual native modules")
    endif()
    foreach(module IN LISTS modules)
        reference_run("${HORO_EXTENSION_CONFORMANCE}" --json "${module}")
    endforeach()
    reference_run("${HORO_REFERENCE_ACTIVATION_TEST}" "${package}" "${identity}" "${shape}")
    if(shape STREQUAL "hybrid-basic")
        reference_run("${CMAKE_COMMAND}" -E env
            "HORO_REFERENCE_PACKAGE_ROOT=${package}"
            "HORO_REFERENCE_CLI=${HORO_REFERENCE_CLI}"
            "${HORO_REFERENCE_CLI_TEST}")
    endif()
endforeach()
