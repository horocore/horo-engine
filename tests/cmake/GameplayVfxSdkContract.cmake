foreach(required SDK_DIR FIXTURE_DIR TEST_ROOT CXX_COMPILER)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing VFX SDK contract input: ${required}")
    endif()
endforeach()
if(NOT BUILD_CONFIG)
    set(BUILD_CONFIG Debug)
endif()
set(generator_args)
if(GENERATOR)
    list(APPEND generator_args -G "${GENERATOR}")
endif()
if(GENERATOR_PLATFORM)
    list(APPEND generator_args -A "${GENERATOR_PLATFORM}")
endif()
if(GENERATOR_TOOLSET)
    list(APPEND generator_args -T "${GENERATOR_TOOLSET}")
endif()
set(toolchain_args)
foreach(setting CMAKE_LINKER CMAKE_OSX_SYSROOT CMAKE_OSX_ARCHITECTURES CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_CXX_FLAGS CMAKE_CXX_FLAGS_DEBUG)
    if(DEFINED ${setting} AND NOT "${${setting}}" STREQUAL "")
        list(APPEND toolchain_args "-D${setting}=${${setting}}")
    endif()
endforeach()
if(EXISTS "${TEST_ROOT}" AND NOT EXISTS "${TEST_ROOT}/.horo-vfx-sdk-contract")
    message(FATAL_ERROR "Refusing to adopt an unowned VFX SDK test directory")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/source")
file(WRITE "${TEST_ROOT}/.horo-vfx-sdk-contract" "HoroGameplayVfxSdkConsumer\n")
file(COPY "${FIXTURE_DIR}/" DESTINATION "${TEST_ROOT}/source")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${TEST_ROOT}/source" -B "${TEST_ROOT}/build"
    ${generator_args} ${toolchain_args}
    "-DHoroEngineGameplay_DIR=${SDK_DIR}" "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}"
    "-DCMAKE_BUILD_TYPE=${BUILD_CONFIG}" RESULT_VARIABLE configured TIMEOUT 90)
if(NOT "${configured}" STREQUAL "0")
    message(FATAL_ERROR "External VFX SDK configure failed: ${configured}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_ROOT}/build" --config "${BUILD_CONFIG}"
    --target HoroGameplayVfxSdkConsumer --parallel 1 RESULT_VARIABLE built TIMEOUT 90)
if(NOT "${built}" STREQUAL "0")
    message(FATAL_ERROR "External VFX SDK consumer build failed: ${built}")
endif()
file(READ "${TEST_ROOT}/build/artifact-${BUILD_CONFIG}.txt" artifact)
execute_process(COMMAND "${artifact}" RESULT_VARIABLE executed TIMEOUT 30)
if(NOT "${executed}" STREQUAL "0")
    message(FATAL_ERROR "External VFX SDK consumer failed: ${executed}")
endif()
