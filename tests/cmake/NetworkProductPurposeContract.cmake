# CTest supplies only the actual built product; no credentials, project files or listeners are created.
if(NOT DEFINED ENGINE OR NOT IS_ABSOLUTE "${ENGINE}" OR NOT EXISTS "${ENGINE}")
    message(FATAL_ERROR "CTest must supply the absolute built engine target")
endif()
foreach(mode dedicated client listen)
    set(arguments --run-network-product "${mode}" 1 127.0.0.1:38984)
    if(mode STREQUAL "listen")
        list(APPEND arguments 127.0.0.1:38984)
    endif()
    # Default Gameplay must never silently become the separately selected transport qualification purpose.
    execute_process(COMMAND "${ENGINE}" ${arguments}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 8)
    if(NOT "${result}" STREQUAL "3")
        message(FATAL_ERROR "${mode} gameplay returned ${result}, expected typed startup rejection: ${output}${error}")
    endif()
    string(FIND "${error}" "network product admission failed (network.admission.policy_invalid," authority_error)
    if(authority_error LESS 0)
        message(FATAL_ERROR "${mode} did not preserve AdmissionPolicyInvalid: ${output}${error}")
    endif()
    if(NOT error MATCHES "Network gameplay requires explicit host-injected world binding and security authorities")
        message(FATAL_ERROR "${mode} failed outside the intended gameplay authority precondition: ${output}${error}")
    endif()
    if(output MATCHES "network product completed")
        message(FATAL_ERROR "${mode} reported a completed gameplay product without its host authorities")
    endif()
endforeach()
message(STATUS "Dedicated, Client and Listen gameplay purpose reject absent host authority before startup")
